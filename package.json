{
  "name": "unbox-ai",
  "version": "0.3.0",
  "description": "Unbox AI traces: visualize agent runs in the browser or explore them from the CLI",
  "license": "MIT",
  "author": "Oskar Kwasniewski <oskar@tester.army>",
  "repository": {
    "type": "git",
    "url": "https://github.com/tester-army/unbox-ai"
  },
  "keywords": [
    "ai",
    "trace",
    "llm",
    "observability",
    "visualization",
    "agent",
    "cli"
  ],
  "type": "module",
  "bin": {
    "unbox-ai": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run build:viewer && npm run build:cli",
    "build:cli": "tsup",
    "build:viewer": "vite build",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test",
    "prepublishOnly": "npm run check && npm run build",
    "release": "release-it"
  },
  "devDependencies": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "@biomejs/biome": "^2.5.10",
    "@release-it/conventional-changelog": "12.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/d3-hierarchy": "3.1.7",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "clsx": "2.1.1",
    "d3-hierarchy": "3.1.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "release-it": "21.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tsup": "8.5.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "^4.1.11"
  }
}
